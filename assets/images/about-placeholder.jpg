<svg xmlns="http://www.w3.org/2000/svg" width="400" height="500" viewBox="0 0 400 500">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0B1F3A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a2f4d;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#bgGrad)"/>
  
  <!-- Accent bar -->
  <rect x="0" y="0" width="400" height="4" fill="#C9A227"/>
  
  <!-- Icon -->
  <circle cx="200" cy="150" r="60" fill="#C9A227" opacity="0.9"/>
  <g transform="translate(200, 150)" fill="#FFFFFF">
    <!-- Building icon -->
    <rect x="-25" y="-40" width="50" height="60" rx="3" fill="none" stroke="#FFFFFF" stroke-width="2"/>
    <line x1="-15" y1="-30" x2="-15" y2="5"/>
    <line x1="0" y1="-30" x2="0" y2="5"/>
    <line x1="15" y1="-30" x2="15" y2="5"/>
    <line x1="-20" y1="-20" x2="20" y2="-20"/>
    <line x1="-20" y1="-5" x2="20" y2="-5"/>
    <rect x="-8" y="-28" width="6" height="6" fill="#0B1F3A"/>
    <rect x="2" y="-28" width="6" height="6" fill="#0B1F3A"/>
    <rect x="-8" y="-14" width="6" height="6" fill="#0B1F3A"/>
    <rect x="2" y="-14" width="6" height="6" fill="#0B1F3A"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="290" font-family="Arial, sans-serif" font-size="20" font-weight="bold" text-anchor="middle" fill="#C9A227">
    About BE RANGERS
  </text>
  <text x="200" y="330" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#FFFFFF" opacity="0.9" width="350">
    Premium Coaching Institute
  </text>
  <text x="200" y="350" font-family="Arial, sans-serif" font-size="11" text-anchor="middle" fill="#FFFFFF" opacity="0.8">
    Bhiwandi, Maharashtra
  </text>
  <text x="200" y="375" font-family="Arial, sans-serif" font-size="10" text-anchor="middle" fill="#C9A227" opacity="0.9">
    Dedicated to Academic Excellence
  </text>
  <text x="200" y="395" font-family="Arial, sans-serif" font-size="9" text-anchor="middle" fill="#FFFFFF" opacity="0.7">
    Click to see more
  </text>
</svg>