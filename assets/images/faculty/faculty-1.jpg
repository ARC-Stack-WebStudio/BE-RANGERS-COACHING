<svg xmlns="http://www.w3.org/2000/svg" width="350" height="450" viewBox="0 0 350 450">
  <!-- Background -->
  <rect width="350" height="450" fill="#E8E8E8"/>
  
  <!-- Accent bar -->
  <rect x="0" y="0" width="350" height="3" fill="#C9A227"/>
  
  <!-- Head -->
  <circle cx="175" cy="100" r="45" fill="#D4A574"/>
  
  <!-- Body -->
  <ellipse cx="175" cy="200" rx="40" ry="50" fill="#0B1F3A"/>
  
  <!-- Shirt -->
  <rect x="135" y="190" width="80" height="70" rx="10" fill="#1a2f4d"/>
  
  <!-- Smile -->
  <path d="M 160 110 Q 175 120 190 110" stroke="#FFFFFF" stroke-width="2" fill="none" opacity="0.7"/>
  
  <!-- Eyes -->
  <circle cx="160" cy="95" r="3" fill="#333333"/>
  <circle cx="190" cy="95" r="3" fill="#333333"/>
  
  <!-- Decorative shapes -->
  <g opacity="0.3" fill="#C9A227">
    <circle cx="30" cy="40" r="20"/>
    <circle cx="320" cy="380" r="25"/>
    <rect x="15" y="300" width="30" height="30" rx="5"/>
  </g>
  
  <!-- Text -->
  <text x="175" y="330" font-family="Arial, sans-serif" font-size="13" font-weight="bold" text-anchor="middle" fill="#0B1F3A">
    Faculty Member
  </text>
  <text x="175" y="350" font-family="Arial, sans-serif" font-size="11" text-anchor="middle" fill="#64748B">
    Expert Educator
  </text>
  <text x="175" y="370" font-family="Arial, sans-serif" font-size="10" text-anchor="middle" fill="#999999">
    Qualified & Experienced
  </text>
  <text x="175" y="405" font-family="Arial, sans-serif" font-size="9" text-anchor="middle" fill="#C9A227">
    BE RANKERS COACHING
  </text>
</svg>