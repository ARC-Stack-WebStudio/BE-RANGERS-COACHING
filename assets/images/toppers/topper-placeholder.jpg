<svg xmlns="http://www.w3.org/2000/svg" width="400" height="500" viewBox="0 0 400 500">
  <!-- Background -->
  <defs>
    <linearGradient id="topperGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0B1F3A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a2f4d;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#topperGrad)"/>
  
  <!-- Gold accent bar -->
  <rect x="0" y="0" width="400" height="4" fill="#C9A227"/>
  
  <!-- Trophy icon -->
  <g transform="translate(200, 80)">
    <circle cx="0" cy="0" r="40" fill="#C9A227" opacity="0.9"/>
    <!-- Trophy cup -->
    <path d="M -20 0 L -15 25 L 15 25 L 20 0 Z" fill="#FFD700" stroke="#C9A227" stroke-width="2"/>
    <!-- Trophy handles -->
    <circle cx="-22" cy="5" r="6" fill="none" stroke="#FFD700" stroke-width="2"/>
    <circle cx="22" cy="5" r="6" fill="none" stroke="#FFD700" stroke-width="2"/>
    <!-- Trophy stem -->
    <rect x="-4" y="25" width="8" height="15" fill="#FFD700"/>
    <!-- Trophy base -->
    <ellipse cx="0" cy="42" rx="18" ry="6" fill="#FFD700"/>
    <!-- Star -->
    <path d="M 0 -15 L 3 -5 L 13 -5 L 5 2 L 8 12 L 0 6 L -8 12 L -5 2 L -13 -5 L -3 -5 Z" fill="#FFFFFF"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="200" font-family="Arial, sans-serif" font-size="18" font-weight="bold" text-anchor="middle" fill="#C9A227">
    Top Performer
  </text>
  <text x="200" y="240" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#FFFFFF">
    Student Name
  </text>
  <text x="200" y="265" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#E5C76B">
    Score: 98.5%
  </text>
  <text x="200" y="285" font-family="Arial, sans-serif" font-size="11" text-anchor="middle" fill="#FFFFFF" opacity="0.9">
    Class 10 - SSC
  </text>
  <text x="200" y="310" font-family="Arial, sans-serif" font-size="10" text-anchor="middle" fill="#FFFFFF" opacity="0.8">
    Outstanding Achievement
  </text>
  <text x="200" y="340" font-family="Arial, sans-serif" font-size="9" text-anchor="middle" fill="#C9A227" opacity="0.9">
    Student Quote:
  </text>
  <text x="200" y="360" font-family="Arial, sans-serif" font-size="9" text-anchor="middle" fill="#FFFFFF" opacity="0.85">
    "BE RANKERS helped me achieve excellence"
  </text>
  <text x="200" y="430" font-family="Arial, sans-serif" font-size="10" text-anchor="middle" fill="#C9A227">
    BE RANKERS COACHING
  </text>
</svg>